from voice song)
      const vStem = vocalsSrc.stems.find((s) => s.kind === 'vocals' && s.buffer);
      if (!vStem) {
        setStatus('Wait until stem separation finishes');
        return;
      }

      // Beat song → instrumental bed (NOT beat vocals). Never stems[0] fallback.
      const beatBed = pickBeatBed(beatSrc);
      if (beatBed.length === 0) {
        setStatus('Wait until stem separation finishes');
        return;
      }

      // Optional melody only from an explicit third source (never voice instrumental)
      let mStem: StemTrack | null = null;
      if (
        melodySrc &&
        melodySrc.id !== vocalsSrc.id &&
        melodySrc.id !== beatSrc.id
      ) {
        mStem =
          melodySrc.stems.find(
            (s) => (s.kind === 'melody' || s.kind === 'other') && s.buffer,
          ) ?? null;
      }

      setBusy(true);
      setStatus('AUTO SYNC: matching tempo + key, building mashup…');
      const targetBpm = beatSrc.bpm ?? project.bpm;
      const targetKey = vocalsSrc.key ?? project.key;

      const usedStemIds = new Set<string>();
      const clips: TimelineClip[] = [];
      let track = 0;

      const make = (stem: StemTrack, src: AudioSource) => {
        const rate = src.bpm ? targetBpm / src.bpm : 1;
        const pitch =
          project.autoHarmonicMatch && src.key
            ? keyDistanceSemitones(src.key, targetKey)
            : 0;
        usedStemIds.add(stem.id);
        clips.push({
          id: uid('clip'),
          stemId: stem.id,
          sourceId: stem.sourceId,
          trackIndex: track++,
          startSec: 0,
          offsetSec: 0,
          durationSec: stem.duration / rate,
          fadeInSec: 0.02,
          fadeOutSec: 0.08,
          muted: false,
          gain: 1,
          pitchSemitones: pitch,
          rate,
        });
      };

      // Clear previous clips by rebuilding from scratch
      for (const bp of beatBed) make(bp, beatSrc);
      make(vStem, vocalsSrc);
      if (mStem && melodySrc) make(mStem, melodySrc);

      const involved = new Set<string>([vocalsSrc.id, beatSrc.id]);
      if (melodySrc && mStem) involved.add(melodySrc.id);

      const nextSources = applyMashupMute(project.sources, usedStemIds, involved);
      const next: ProjectState = {
        ...project,
        bpm: targetBpm,
        key: targetKey,
        clips,
        sources: nextSources,
        updatedAt: Date.now(),
      };

      // Sync engine with the NEW project state (avoid stale closure)
      setProject(next);
      syncEngine(next);
      setBusy(false);
      setStatus(
        `Playing vocals from ${vocalsSrc.name} over instrumental from ${beatSrc.name}`,
      );
    },
    [project, syncEngine],
  );

  const runSmartRemix = useCallback(() => {
    const separated = project.sources.filter(
      (s) => s.status === 'separated' && s.stems.some((st) => Boolean(st.buffer)),
    );
    if (separated.length < 2) {
      setStatus('Import & separate at least 2 songs for Smart Remix.');
      return;
    }
    const props: RemixProposal[] = [];
    for (let i = 0; i < separated.length; i++) {
      for (let j = 0; j < separated.length; j++) {
        if (i === j) continue;
        const A = separated[i];
        const B = separated[j];
        const { score, notes } = compatibilityScore(
          A.bpm ?? 120,
          A.key ?? 'C major',
          B.bpm ?? 120,
          B.key ?? 'C major',
        );
        const v = A.stems.find((s) => s.kind === 'vocals' && s.buffer);
        if (!v) continue;
        const bed = pickBeatBed(B);
        if (bed.length === 0) continue;
        const assignments: RemixProposal['assignments'] = [
          ...bed.map((st) => ({
            role: st.kind as StemKind,
            sourceId: B.id,
            stemId: st.id,
          })),
          { role: 'vocals' as StemKind, sourceId: A.id, stemId: v.id },
        ];
        props.push({
          id: uid('remix'),
          title: `Vocals ${A.name} + Beat ${B.name}`,
          score,
          notes: [
            ...notes,
            'Mashup: vocals-only over instrumental (no beat vocals).',
          ],
          assignments,
        });
      }
    }
    props.sort((a, b) => b.score - a.score);
    const top = props.slice(0, 3);
    // Optional third: vocals from A + instrumental from C (not layered full songs)
    if (separated.length >= 3 && top.length >= 2) {
      const voiceSrc = separated[0];
      const C = separated[2];
      const v = voiceSrc.stems.find((s) => s.kind === 'vocals' && s.buffer);
      const bed = pickBeatBed(C);
      if (v && bed.length > 0) {
        const { score, notes } = compatibilityScore(
          voiceSrc.bpm ?? 120,
          voiceSrc.key ?? 'C',
          C.bpm ?? 120,
          C.key ?? 'C',
        );
        top[2] = {
          id: uid('remix'),
          title: `Vocals ${voiceSrc.name} + Beat ${C.name}`,
          score: score - 5,
          notes: [...notes, 'Alternate beat bed from third source.'],
