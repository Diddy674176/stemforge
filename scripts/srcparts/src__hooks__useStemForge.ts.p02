      muted: false,
        gain: 1,
        pitchSemitones: pitch,
        rate,
      };
      setProject((p) => ({ ...p, clips: [...p.clips, clip], selectedClipId: clip.id }));
      setStatus(`Added ${stem.name} to timeline (rate ${rate.toFixed(3)}, pitch ${pitch >= 0 ? '+' : ''}${pitch}).`);
    },
    [project, playhead],
  );

  const moveClip = useCallback((clipId: string, startSec: number) => {
    setProject((p) => ({
      ...p,
      clips: p.clips.map((c) =>
        c.id === clipId
          ? { ...c, startSec: snapTime(startSec, p.bpm, p.snap) }
          : c,
      ),
    }));
  }, []);

  const splitClip = useCallback((clipId: string, atSec: number) => {
    setProject((p) => {
      const clip = p.clips.find((c) => c.id === clipId);
      if (!clip) return p;
      const local = atSec - clip.startSec;
      if (local <= 0.05 || local >= clip.durationSec - 0.05) return p;
      const a: TimelineClip = {
        ...clip,
        durationSec: local,
        fadeOutSec: 0.02,
      };
      const b: TimelineClip = {
        ...clip,
        id: uid('clip'),
        startSec: atSec,
        offsetSec: clip.offsetSec + local * clip.rate,
        durationSec: clip.durationSec - local,
        fadeInSec: 0.02,
      };
      return {
        ...p,
        clips: p.clips.flatMap((c) => (c.id === clipId ? [a, b] : [c])),
      };
    });
  }, []);

  const deleteClip = useCallback((clipId: string) => {
    setProject((p) => ({
      ...p,
      clips: p.clips.filter((c) => c.id !== clipId),
      selectedClipId: p.selectedClipId === clipId ? null : p.selectedClipId,
    }));
  }, []);

  const setBpm = useCallback((bpm: number) => {
    setProject((p) => {
      const next = { ...p, bpm };
      // Retarget clip rates
      next.clips = p.clips.map((c) => {
        const src = p.sources.find((s) => s.id === c.sourceId);
        const rate = src?.bpm ? bpm / src.bpm : c.rate;
        return { ...c, rate };
      });
      return next;
    });
  }, []);

  const setKey = useCallback((key: string) => {
    setProject((p) => {
      const next = { ...p, key };
      if (p.autoHarmonicMatch) {
        next.clips = p.clips.map((c) => {
          const src = p.sources.find((s) => s.id === c.sourceId);
          const pitch = src?.key ? keyDistanceSemitones(src.key, key) : 0;
          return { ...c, pitchSemitones: pitch };
        });
      }
      return next;
    });
  }, []);

  const applyMasterPreset = useCallback((preset: MasterPresetId) => {
    setProject((p) => ({
      ...p,
      master: { ...p.master, ...MASTER_PRESETS[preset], preset },
    }));
    engine.setMaster({ ...project.master, ...MASTER_PRESETS[preset], preset });
  }, [project.master]);

  /** Beat bed: prefer instrumental (drums+bass+other); never beat vocals. */
  const pickBeatBed = (beatSrc: AudioSource): StemTrack[] => {
    const instrumental = beatSrc.stems.find(
      (s) => s.kind === 'instrumental' && s.buffer,
    );
    if (instrumental) return [instrumental];
    const parts: StemKind[] = ['drums', 'bass', 'other'];
    return parts
      .map((k) => beatSrc.stems.find((s) => s.kind === k && s.buffer))
      .filter((s): s is StemTrack => Boolean(s));
  };

  const volumeForKind = (kind: StemKind): number => {
    if (kind === 'vocals') return 0.95;
    if (kind === 'instrumental') return 0.85;
    if (kind === 'drums') return 0.8;
    if (kind === 'bass') return 0.75;
    if (kind === 'melody' || kind === 'other') return 0.65;
    return 0.8;
  };

  /** Mute every stem on involved sources that is not used in the mashup clips. */
  const applyMashupMute = (
    sources: AudioSource[],
    usedStemIds: Set<string>,
    involvedSourceIds: Set<string>,
  ): AudioSource[] =>
    sources.map((src) => {
      if (!involvedSourceIds.has(src.id)) return src;
      return {
        ...src,
        stems: src.stems.map((st) => {
          const used = usedStemIds.has(st.id);
          return {
            ...st,
            muted: !used,
            volume: used ? volumeForKind(st.kind) : st.volume,
          };
        }),
      };
    });

  const autoSyncBeginner = useCallback(
    async (vocalsSrcId: string, beatSrcId: string, melodySrcId: string | null) => {
      const vocalsSrc = project.sources.find((s) => s.id === vocalsSrcId);
      const beatSrc = project.sources.find((s) => s.id === beatSrcId);
      const melodySrc = melodySrcId
        ? project.sources.find((s) => s.id === melodySrcId)
        : null;
      if (!vocalsSrc || !beatSrc) {
        setStatus('Pick vocals and beat sources first.');
        return;
      }

      const isSeparated = (s: AudioSource) =>
        s.status === 'separated' && s.stems.some((st) => Boolean(st.buffer));
      if (
        !isSeparated(vocalsSrc) ||
        !isSeparated(beatSrc) ||
        (melodySrc && !isSeparated(melodySrc))
      ) {
        setStatus('Wait until stem separation finishes');
        return;
      }

      // Voice song → vocals ONLY (never instrumental/drums 