;
        setStatus(`Exported ${format.toUpperCase()}.`);
      } catch (e) {
        setStatus(`Export failed: ${e instanceof Error ? e.message : e}`);
      }
      setBusy(false);
    },
    [allStems, duration, project],
  );

  const exportStem = useCallback(
    async (stem: StemTrack, format: ExportFormat) => {
      if (!stem.buffer) return;
      setBusy(true);
      const blob = await exportBuffer(stem.buffer, format);
      downloadBlob(blob, `${stem.name}.${format}`);
      setBusy(false);
      setStatus(`Exported stem ${stem.name}.`);
    },
    [],
  );

  const saveProject = useCallback(async () => {
    setBusy(true);
    setStatus('Saving project to IndexedDB…');
    try {
      const audio: SavedAudioBlob[] = [];
      for (const src of project.sources) {
        if (src.buffer) {
          audio.push({
            id: uid('aud'),
            projectId: project.id,
            refId: src.id,
            kind: 'source',
            sampleRate: src.sampleRate,
            channels: src.buffer.numberOfChannels,
            pcm: audioBufferToPcm(src.buffer),
            name: src.name,
            meta: { bpm: src.bpm, key: src.key, fileName: src.fileName },
          });
        }
        for (const stem of src.stems) {
          if (!stem.buffer) continue;
          audio.push({
            id: uid('aud'),
            projectId: project.id,
            refId: stem.id,
            kind: 'stem',
            sampleRate: stem.sampleRate,
            channels: stem.buffer.numberOfChannels,
            pcm: audioBufferToPcm(stem.buffer),
            name: stem.name,
            meta: {
              sourceId: stem.sourceId,
              kind: stem.kind,
              volume: stem.volume,
              pan: stem.pan,
              color: stem.color,
            },
          });
        }
      }
      const serializable = {
        ...project,
        sources: project.sources.map((s) => ({
          ...s,
          buffer: null,
          stems: s.stems.map((st) => ({ ...st, buffer: null, peaks: Array.from(st.peaks) })),
          peaks: Array.from(s.peaks),
          structure: s.structure,
        })),
      };
      await saveProjectRecord(
        {
          meta: {
            id: project.id,
            name: project.name,
            updatedAt: Date.now(),
            createdAt: project.createdAt,
            bpm: project.bpm,
            key: project.key,
            sourceCount: project.sources.length,
            clipCount: project.clips.length,
          },
          stateJson: JSON.stringify(serializable),
        },
        audio,
      );
      setSavedList(await listProjects());
      setStatus('Project saved locally (IndexedDB).');
    } catch (e) {
      setStatus(`Save failed: ${e instanceof Error ? e.message : e}`);
    }
    setBusy(false);
  }, [project]);

  const loadSaved = useCallback(async (id: string) => {
    setBusy(true);
    setStatus('Loading project…');
    try {
      const data = await loadProject(id);
      if (!data) throw new Error('Not found');
      const state = JSON.parse(data.record.stateJson) as ProjectState;
      const ctx = new AudioContext();
      const byRef = new Map(data.audio.map((a) => [a.refId, a]));
      state.sources = await Promise.all(
        state.sources.map(async (src) => {
          const a = byRef.get(src.id);
          let buffer: AudioBuffer | null = null;
          if (a) buffer = pcmToAudioBuffer(ctx, a.pcm, a.sampleRate, a.channels);
          const stems = await Promise.all(
            src.stems.map(async (st) => {
              const sa = byRef.get(st.id);
              let sb: AudioBuffer | null = null;
              if (sa) sb = pcmToAudioBuffer(ctx, sa.pcm, sa.sampleRate, sa.channels);
              return {
                ...st,
                peaks: Float32Array.from(st.peaks as unknown as number[]),
                buffer: sb,
                fx: st.fx ?? defaultStemFx(),
              };
            }),
          );
          return {
            ...src,
            peaks: Float32Array.from(src.peaks as unknown as number[]),
            buffer,
            stems,
          };
        }),
      );
      await ctx.close().catch(() => undefined);
      setProject({ ...state, updatedAt: Date.now() });
      setRightsAccepted(true);
      setStatus(`Loaded ${state.name}.`);
    } catch (e) {
      setStatus(`Load failed: ${e instanceof Error ? e.message : e}`);
    }
    setBusy(false);
  }, []);

  const removeSaved = useCallback(async (id: string) => {
    await deleteProject(id);
    setSavedList(await listProjects());
  }, []);

  const selectedStem = allStems.find((s) => s.id === project.selectedStemId) ?? null;

  const aiMix = useCallback(() => {
    setProject((p) => {
      const next = { ...p };
      next.sources = p.sources.map((src) => ({
        ...src,
        stems: src.stems.map((st) => {
          const vol =
            st.kind === 'vocals'
              ? 0.92
              : st.kind === 'drums'
   