 vocalsSrc);
      if (mStem && melodySrc) make(mStem, melodySrc);

      const involved = new Set<string>([vocalsSrc.id, beatSrc.id]);
      if (melodySrc && mStem) involved.add(melodySrc.id);

      const gains = computeMashupGains(vStem, beatBed, voiceBalance);
      const nextSources = applyMashupMute(
        project.sources,
        usedStemIds,
        involved,
        gains,
      );
      const next: ProjectState = {
        ...project,
        bpm: targetBpm,
        key: targetKey,
        clips,
        sources: nextSources,
        updatedAt: Date.now(),
      };

      // Sync engine with the NEW project state (avoid stale closure)
      setProject(next);
      syncEngine(next);
      setBusy(false);
      setStatus(
        `Vocals prioritized in mix — ${vocalsSrc.name} (vol ${gains.vocals.toFixed(2)}) over ${beatSrc.name} bed (vol ${gains.bed.toFixed(2)}, ~${gains.targetDb.toFixed(0)} dB)`,
      );
    },
    [project, syncEngine],
  );

  const runSmartRemix = useCallback(() => {
    const separated = project.sources.filter(
      (s) => s.status === 'separated' && s.stems.some((st) => Boolean(st.buffer)),
    );
    if (separated.length < 2) {
      setStatus('Import & separate at least 2 songs for Smart Remix.');
      return;
    }
    const props: RemixProposal[] = [];
    for (let i = 0; i < separated.length; i++) {
      for (let j = 0; j < separated.length; j++) {
        if (i === j) continue;
        const A = separated[i];
        const B = separated[j];
        const { score, notes } = compatibilityScore(
          A.bpm ?? 120,
          A.key ?? 'C major',
          B.bpm ?? 120,
          B.key ?? 'C major',
        );
        const v = A.stems.find((s) => s.kind === 'vocals' && s.buffer);
        if (!v) continue;
        const bed = pickBeatBed(B);
        if (bed.length === 0) continue;
        const assignments: RemixProposal['assignments'] = [
          ...bed.map((st) => ({
            role: st.kind as StemKind,
            sourceId: B.id,
            stemId: st.id,
          })),
          { role: 'vocals' as StemKind, sourceId: A.id, stemId: v.id },
        ];
        props.push({
          id: uid('remix'),
          title: `Vocals ${A.name} + Beat ${B.name}`,
          score,
          notes: [
            ...notes,
            'Mashup: vocals-only over instrumental (no beat vocals).',
          ],
          assignments,
        });
      }
    }
    props.sort((a, b) => b.score - a.score);
    const top = props.slice(0, 3);
    // Optional third: vocals from A + instrumental from C (not layered full songs)
    if (separated.length >= 3 && top.length >= 2) {
      const voiceSrc = separated[0];
      const C = separated[2];
      const v = voiceSrc.stems.find((s) => s.kind === 'vocals' && s.buffer);
      const bed = pickBeatBed(C);
      if (v && bed.length > 0) {
        const { score, notes } = compatibilityScore(
          voiceSrc.bpm ?? 120,
          voiceSrc.key ?? 'C',
          C.bpm ?? 120,
          C.key ?? 'C',
        );
        top[2] = {
          id: uid('remix'),
          title: `Vocals ${voiceSrc.name} + Beat ${C.name}`,
          score: score - 5,
          notes: [...notes, 'Alternate beat bed from third source.'],
          assignments: [
            ...bed.map((st) => ({
              role: st.kind as StemKind,
              sourceId: C.id,
              stemId: st.id,
            })),
            { role: 'vocals' as StemKind, sourceId: voiceSrc.id, stemId: v.id },
          ],
        };
      }
    }
    setProposals(top.filter(Boolean).slice(0, 3));
    setStatus(`Smart Remix proposed ${Math.min(3, top.length)} combinations.`);
  }, [project.sources]);

  const loadProposal = useCallback(
    (prop: RemixProposal) => {
      const clips: TimelineClip[] = [];
      const usedStemIds = new Set<string>();
      const involved = new Set<string>();
      prop.assignments.forEach((a, idx) => {
        const src = project.sources.find((s) => s.id === a.sourceId);
        const stem = src?.stems.find((s) => s.id === a.stemId);
        if (!src || !stem || !stem.buffer) return;
        // Never schedule beat-song vocals or wrong kinds via stale proposals
        if (a.role === 'vocals' && stem.kind !== 'vocals') return;
        const rate = src.bpm ? project.bpm / src.bpm : 1;
        const pitch =
          project.autoHarmonicMatch && src.key
            ? keyDistanceSemitones(src.key, project.key)
            : 0;
        usedStemIds.add(stem.id);
        involved.add(src.id);
        clips.push({
          id: uid('clip'),
          stemId: stem.id,
          sourceId: src.id,
          trackIndex: idx,
          startSec: 0,
          offsetSec: 0,
          durationSec: stem.duration / rate,
          fadeInSec: 0.02,
          fadeOutSec: 0.08,
          muted: false,
          gain: 1,
          pitchSemitones: pitch,
          rate,
        });
      });
      if (clips.length === 0) {
        setStatus('Proposal stems missing — wait unt