32Array(n);
  let lp = 0;
  let lpR = 0;
  const a = 0.02;
  for (let i = 0; i < n; i++) {
    lp = lp + a * (L[i] - lp);
    lpR = lpR + a * (R[i] - lpR);
    bassL[i] = lp;
    bassR[i] = lpR;
    const hp = L[i] - lp;
    const hpR = R[i] - lpR;
    drumsL[i] = hp * 0.6 + sideL[i] * 0.4;
    drumsR[i] = hpR * 0.6 + sideR[i] * 0.4;
  }
  const voc = channelsToBuffer(ctx, midL, midR, buffer.sampleRate);
  const drm = channelsToBuffer(ctx, drumsL, drumsR, buffer.sampleRate);
  const bas = channelsToBuffer(ctx, bassL, bassR, buffer.sampleRate);
  const oth = channelsToBuffer(ctx, sideL, sideR, buffer.sampleRate);
  const mono = mixdownMono(L, R);
  return [
    makeStem(sourceId, 'vocals', voc, computePeaks(mixdownMono(midL, midR))),
    makeStem(sourceId, 'drums', drm, computePeaks(mixdownMono(drumsL, drumsR))),
    makeStem(sourceId, 'bass', bas, computePeaks(mixdownMono(bassL, bassR))),
    makeStem(sourceId, 'other', oth, computePeaks(mixdownMono(sideL, sideR))),
    makeStem(
      sourceId,
      'instrumental',
      channelsToBuffer(
        ctx,
        Float32Array.from(L, (_, i) => L[i] - midL[i] * 0.5),
        Float32Array.from(R, (_, i) => R[i] - midR[i] * 0.5),
        buffer.sampleRate,
      ),
      computePeaks(mono),
    ),
  ];
}
