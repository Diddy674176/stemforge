/**
 * BPM, key, and structure heuristics — runs on main or can be called from workers.
 * Local-only analysis of user-imported audio.
 */

import { computePeaks, mixdownMono, fft } from './dsp';
import type { StructureLabel, StructureMarker } from './types';
import { uid } from './types';

const NOTE_NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'] as const;

/** Autocorrelation-ish onset BPM estimate (60–200). */
export function detectBpm(mono: Float32Array, sampleRate: number): number {
  const hop = 512;
  const frame = 1024;
  const nFrames = Math.max(1, Math.floor((mono.length - frame) / hop));
  const flux = new Float32Array(nFrames);
  let prev = new Float32Array(frame / 2);

  // Spectral flux onset envelope (coarse DFT energy bands)
  for (let f = 0; f < nFrames; f++) {
    const off = f * hop;
    const bands = 32;
    const cur = new Float32Array(bands);
    for (let b = 0; b < bands; b++) {
      let e = 0;
      const a = Math.floor((b / bands) * frame);
      const c = Math.floor(((b + 1) / bands) * frame);
      for (let i = a; i < c; i++) {
        const s = mono[off + i] ?? 0;
        e += s * s;
      }
      cur[b] = Math.sqrt(e / Math.max(1, c - a));
    }
    let sum = 0;
    for (let b = 0; b < bands; b++) {
      const d = cur[b] - (prev[b] ?? 0);
      if (d > 0) sum += d;
    }
    flux[f] = sum;
    prev = cur;
  }

  // Normalize
  let mx = 0;
  for (let i = 0; i < flux.length; i++) if (flux[i] > mx) mx = flux[i];
  if (mx > 0) for (let i = 0; i < flux.length; i++) flux[i] /= mx;

  const fps = sampleRate / hop;
  const minBpm = 70;
  const maxBpm = 180;
  let bestBpm = 120;
  let bestScore = -1;

  for (let bpm = minBpm; bpm <= maxBpm; bpm++) {
    const period = (60 / bpm) * fps;
    let score = 0;
    const lags = [period, period * 2, period / 2];
    for (const lag of lags) {
      if (lag < 2 || lag >= flux.length) continue;
      const li = Math.round(lag);
      let corr = 0;
      let count = 0;
      for (let i = 0; i + li < flux.length; i += 2) {
        corr += flux[i] * flux[i + li];
        count++;
      }
      score += (corr / Math.max(1, count)) * (lag === period ? 1.5 : 0.6);
    }
    if (score > bestScore) {
      bestScore = score;
      bestBpm = bpm;
    }
  }

  // Prefer even BPMs slightly when close
  return Math.round(bestBpm);
}

/** Chromagram-ish key detection (Krumhansl-ish profiles). */
export function detectKey(mono: Float32Array, sampleRate: number): string {
  const chroma = new Float32Array(12);
  const hop = 2048;
  const n = Math.floor(mono.length / hop);

  // Better: DFT peak mapping for a subset of frames
  const fftSize = 4096;
  const re = new Float32Array(fftSize);
  const im = new Float32Array(fftSize);
  const frames = Math.min(80, Math.floor((mono.length - fftSize) / (fftSize / 2)));

  for (let f = 0; f < frames; f++) {
    const off = f * (fftSize / 2);
    re.fill(0);
    im.fill(0);
    for (let i = 0; i < fftSize; i++) {
      const w = 0.5 * (1 - Math.cos((2 * Math.PI * i) / (fftSize - 1)));
      re[i] = (mono[off + i] ?? 0) * w;
    }
    fft(re, im);
    for (let k = 1; k < fftSize / 2; k++) {
      const freq = (k * sampleRate) / fftSize;
      if (freq < 60 || freq > 5000) continue;
      const midi = 69 + 12 * Math.log2(freq / 440);
      const pc = ((Math.round(midi) % 12) + 12) % 12;
      const mag = Math.hypot(re[k], im[k]);
      chroma[pc] += mag;
    }
  }

  let s = 0;
  for (let i = 0; i < 12; i++) s += chroma[i];
  if (s > 0) for (let i = 0; i < 12; i++) chroma[i] /= s;

  const major = [6.35, 2.23, 3.48, 2.33, 4.38, 4.09, 2.52, 5.19, 2.39, 3.66, 2.29, 2.88];
  const minor = [6.33, 2.68, 3.52, 5.38, 2.6, 3.53, 2.54, 4.75, 3.98, 2.69, 3.34, 3.17];

  let best = { key: 'C major', score: -Infinity };
  for (let root = 0; root < 12; root++) {
    let maj = 0;
    let min = 0;
    for (let i = 0; i < 12; i++) {
      maj += chroma[i] * major[(i - root + 12) % 12];
      min += chroma[i] * minor[(i - root + 12) % 12];
    }
    if (maj > best.score) best = { key: `${NOTE_NAMES[root]} major`, score: maj };
    if (min > best.score) best = { key: `${NOTE_NAMES[root]} minor`, score: min };
  }
  return best.key;
}


/** Semitone distance for harmonic match (shortest path, prefer same mode). */
export function keyDistanceSemitones(fromKey: string, toKey: string): number {
  const parse = (k: string) => {
    const m = k.trim().match(/^([A-G]#?)\s*(major|minor)$/i);
    if (!m) return { root: 0, minor: false };
    const root = NOTE_NAMES.indexOf(m[1].toUpperCase() as (typeof NOTE_NAMES)[number]);
    return { root: root < 0 ? 0 : root, minor: /minor/i.test(m[2]) };
  };
  const a = parse(fromKey);
  const b = parse(toKey);
  let d = b.root - a.root;
  if (d > 6) d -= 12;
  if (d < -6) d += 12;
  // Relative major/minor often ±3 — if modes differ and roots align to relative, prefer 0 pitch + note
  if (a.minor !== b.minor) {
    // keep chromatic distance as pitch shift target
  }
  return d;
}

