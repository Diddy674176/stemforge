il stem separation finishes');
        return;
      }
      const vAssign = prop.assignments.find((a) => a.role === 'vocals');
      const bedAssigns = prop.assignments.filter(
        (a) => a.role !== 'vocals',
      );
      const vStemForGain = project.sources
        .flatMap((s) => s.stems)
        .find((s) => s.id === vAssign?.stemId);
      const bedStemsForGain = bedAssigns
        .map((a) =>
          project.sources.flatMap((s) => s.stems).find((s) => s.id === a.stemId),
        )
        .filter((s): s is StemTrack => Boolean(s));
      const gains =
        vStemForGain && bedStemsForGain.length
          ? computeMashupGains(vStemForGain, bedStemsForGain, 0.72)
          : { vocals: 1.08, bed: 0.52, targetDb: 7.5 };
      const nextSources = applyMashupMute(
        project.sources,
        usedStemIds,
        involved,
        gains,
      );
      const next: ProjectState = {
        ...project,
        clips,
        sources: nextSources,
        updatedAt: Date.now(),
      };
      setProject(next);
      syncEngine(next);
      const vName =
        project.sources.find((s) => s.id === vAssign?.sourceId)?.name ?? 'voice';
      const bName =
        project.sources.find((s) => s.id === bedAssigns[0]?.sourceId)?.name ?? 'beat';
      setStatus(
        `Vocals prioritized in mix — ${vName} over ${bName} (vol ${gains.vocals.toFixed(2)} / ${gains.bed.toFixed(2)})`,
      );
    },
    [project, syncEngine],
  );

  const exportMix = useCallback(
    async (format: ExportFormat) => {
      setBusy(true);
      setStatus('Rendering mix…');
      try {
        const stemsById = new Map(allStems.map((s) => [s.id, s]));
        const buffer = await renderMix({
          sampleRate: 44100,
          durationSec: Math.max(duration, 1),
          clips: project.clips,
          stemsById,
          master: project.master,
          onProgress: (p) => setStatus(`Rendering… ${Math.round(p * 100)}%`),
        });
        const blob = await exportBuffer(buffer, format);
        downloadBlob(blob, `${project.name || 'stemforge-mix'}.${format}`);
        setStatus(`Exported ${format.toUpperCase()}.`);
      } catch (e) {
        setStatus(`Export failed: ${e instanceof Error ? e.message : e}`);
      }
      setBusy(false);
    },
    [allStems, duration, project],
  );

  const exportStem = useCallback(
    async (stem: StemTrack, format: ExportFormat) => {
      if (!stem.buffer) return;
      setBusy(true);
      const blob = await exportBuffer(stem.buffer, format);
      downloadBlob(blob, `${stem.name}.${format}`);
      setBusy(false);
      setStatus(`Exported stem ${stem.name}.`);
    },
    [],
  );

  const saveProject = useCallback(async () => {
    setBusy(true);
    setStatus('Saving project to IndexedDB…');
    try {
      const audio: SavedAudioBlob[] = [];
      for (const src of project.sources) {
        if (src.buffer) {
          audio.push({
            id: uid('aud'),
            projectId: project.id,
            refId: src.id,
            kind: 'source',
            sampleRate: src.sampleRate,
            channels: src.buffer.numberOfChannels,
            pcm: audioBufferToPcm(src.buffer),
            name: src.name,
            meta: { bpm: src.bpm, key: src.key, fileName: src.fileName },
          });
        }
        for (const stem of src.stems) {
          if (!stem.buffer) continue;
          audio.push({
            id: uid('aud'),
            projectId: project.id,
            refId: stem.id,
            kind: 'stem',
            sampleRate: stem.sampleRate,
            channels: stem.buffer.numberOfChannels,
            pcm: audioBufferToPcm(stem.buffer),
            name: stem.name,
            meta: {
              sourceId: stem.sourceId,
              kind: stem.kind,
              volume: stem.volume,
              pan: stem.pan,
              color: stem.color,
            },
          });
        }
      }
      const serializable = {
        ...project,
        sources: project.sources.map((s) => ({
          ...s,
          buffer: null,
          stems: s.stems.map((st) => ({ ...st, buffer: null, peaks: Array.from(st.peaks) })),
          peaks: Array.from(s.peaks),
          structure: s.structure,
        })),
      };
      await saveProjectRecord(
        {
          meta: {
            id: project.id,
            name: project.name,
            updatedAt: Date.now(),
            createdAt: project.createdAt,
            bpm: project.bpm,
            key: project.key,
            sourceCount: project.sources.length,
            clipCount: project.clips.length,
          },
          stateJson: JSON.stringify(serializable),
        },
        audio,
      );
      setSavedList(await listProjects());
      setStatus('Project saved locally (IndexedDB).');
    } catch (e) {
      setStatus(`Save failed: ${e instanceof Error ? e.message : e}`);
    }
    setBusy(false);
  }, [project]);

  const loadSaved = useCallback(async (id: string) => {
    setBusy(tru